{
  "expo": {
    "name": "Sport Overlay Fire TV",
    "slug": "sport-overlay-fire-tv",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon-1024.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "tech.hokentech.sportoverlay",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.OPEN_DOCUMENT_TREE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-1024.png",
        "backgroundColor": "#07111F"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true
        }
      ],
      "./plugins/withFireTv.js"
    ],
    "extra": {
      "eas": {
        "projectId": "71823f49-de0d-4540-aa0d-7397f45ef12b"
      }
    },
    "owner": "alanone89"
  }
}
